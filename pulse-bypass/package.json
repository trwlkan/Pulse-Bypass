{
  "name": "pulse-bypass",
  "productName": "Pulse Bypass",
  "version": "1.0.0",
  "description": "Обход блокировок YouTube, Discord и других сервисов на движке zapret (winws.exe / WinDivert) с автоподбором стратегии.",
  "main": "main.js",
  "author": "Pulse",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "fetch-engine": "node scripts/download-zapret.js",
    "predist": "node scripts/download-zapret.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "adm-zip": "^0.5.12"
  },
  "build": {
    "appId": "com.pulse.bypass",
    "productName": "Pulse Bypass",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "engine/**/*",
      "!engine/vendor/**/*.zip"
    ],
    "extraResources": [
      {
        "from": "engine/vendor/zapret",
        "to": "zapret",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
